# 백엔드 API 통신 연동을 위한 기본 엔드포인트 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# 조직별 플랫폼 관리자 이메일 설정 (기본값: admin@kubeguard.local)
NEXT_PUBLIC_ADMIN_EMAIL=admin@kubeguard.local

# 사내 헬프데스크 또는 문의 포털 연동으로 사용자 지원 접근성 향상 (미설정 시 이메일 mailto로 자동 폴백)
# NEXT_PUBLIC_ADMIN_CONTACT_URL=https://support.example.com/helpdesk

# 조직별 SSO/IdP 비밀번호 재설정 포털 연동 (미설정 시 플랫폼 관리자 대상 메일 요청으로 자동 폴백)
# NEXT_PUBLIC_FORGOT_PASSWORD_URL=https://sso.example.com/reset-password

