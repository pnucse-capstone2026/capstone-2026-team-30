# NestJS 백엔드 환경 변수
# devcontainer의 docker-compose.yml에서 실행되는 PostgreSQL에 맞춤

NODE_ENV=development
PORT=3001

# Database (docker-compose.yml 기준)
DATABASE_URL="postgresql://devuser:devpassword@postgres:5432/kyverno_dashboard?schema=public"

# JWT
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password
