# NestJS 백엔드 환경 변수 템플릿
# PostgreSQL, JWT 인증, 멀티클러스터 K8s Provider 및 AWS Bedrock AI Agent 설정을 통합 관리하기 위한 목적

NODE_ENV=development
PORT=3001

# PostgreSQL 데이터베이스 연결 URL (Prisma ORM 연결 목적)
DATABASE_URL="postgresql://devuser:devpassword@postgres:5432/kyverno_dashboard?schema=public"

# JWT 인증 토큰 시크릿 및 유효 기간 (무인가 요청 차단 목적)
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 초기 관리자 계정 시드 설정
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password

# --- Kubernetes cluster provider (PR #10 멀티클러스터 지원) ---
# CLUSTER_PROVIDER 를 명시하지 않으면 KUBERNETES_CLUSTERS / KUBERNETES_CLUSTERS_FILE 가
# 있을 때 multi, 없으면 single 로 동작합니다. (single|multi)
# CLUSTER_PROVIDER=single

# --- single 모드 (앱이 떠 있는 클러스터 하나만 사용) ---
KUBERNETES_CLUSTER_ID=default
KUBERNETES_CLUSTER_DISPLAY_NAME=Default
KUBERNETES_EXCEPTION_NAMESPACE=kyverno

# 정책 예외 리컨실러. 정상 APPROVED 재점검 주기와 실행 claim TTL(초)
EXCEPTION_APPROVED_RECHECK_INTERVAL_SECONDS=300
EXCEPTION_RECONCILE_CLAIM_TTL_SECONDS=60

# --- multi 모드 ---
# 클러스터 목록(JSON 배열)을 주입합니다. 실제 토큰/인증서는 커밋하지 말고
# Kubernetes Secret 으로 주입하세요.
#  - KUBERNETES_CLUSTERS       : JSON 문자열 (secretKeyRef 로 주입)
#  - KUBERNETES_CLUSTERS_FILE  : 마운트된 JSON 파일 경로 (Secret 볼륨 마운트, 권장)
# 항목 필드: id(필수), displayName?, exceptionNamespace?(기본 kyverno),
#            server(필수, https URL), caData? | caFile? | skipTLSVerify?,
#            tlsServerName?, 인증은 token XOR (clientCertData + clientKeyData),
#            default?(기본 클러스터 지정)
# 아래는 자격증명이 없는 구조 예시일 뿐입니다.
# KUBERNETES_CLUSTERS='[{"id":"prod","displayName":"Production","exceptionNamespace":"kyverno","server":"https://prod.example.com:6443","caData":"<base64-ca>","token":"<bearer-token>","default":true},{"id":"staging","displayName":"Staging","server":"https://staging.example.com:6443","caData":"<base64-ca>","token":"<bearer-token>"}]'
# KUBERNETES_CLUSTERS_FILE=/etc/kyverno-dashboard/clusters.json

# --- AWS Bedrock AI Agent 연동 설정 (Kyverno 오류 원인 분석 및 해결 가이드 생성) ---
# AWS 표준 리전 (us-east-1 기본 사용)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bedrock에서 사용할 파운데이션 모델 식별자 (Claude 3.5 Sonnet)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
