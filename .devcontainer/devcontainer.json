{
    "name": "kyverno-dashboard-Development-environment",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "runArgs": [
        "--network=kind"
    ],
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "latest",
            "helm": "latest"
        },
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "dockerDashComposeVersion": "v2"
        }
    },
    "mounts": [
        "source=${localEnv:USERPROFILE}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached",
        "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
        "source=kyverno-platform-pnpm-store,target=${containerWorkspaceFolder}/.pnpm-store,type=volume",
        "source=kyverno-platform-root-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
        "source=kyverno-platform-frontend-node-modules,target=${containerWorkspaceFolder}/apps/frontend/node_modules,type=volume",
        "source=kyverno-platform-backend-node-modules,target=${containerWorkspaceFolder}/apps/backend/node_modules,type=volume",
        "source=kyverno-platform-shared-node-modules,target=${containerWorkspaceFolder}/packages/shared/node_modules,type=volume",
        "source=kyverno-platform-frontend-next,target=${containerWorkspaceFolder}/apps/frontend/.next,type=volume"
    ],
    "postCreateCommand": "bash .devcontainer/scripts/setup.sh && docker compose -f .devcontainer/docker-compose.yml up -d",
    "forwardPorts": [
        3000,
        3001
    ],
    "portsAttributes": {
        "3000": {
            "label": "frontend",
            "onAutoForward": "openBrowser"
        },
        "3001": {
            "label": "backend",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "ms-azuretools.vscode-docker",
                "redhat.vscode-yaml",
                "mtxr.sqltools",
                "rangav.vscode-thunder-client",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode"
            ]
        }
    },
    "remoteUser": "vscode"
}
